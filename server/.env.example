# ============================================================
# XiCheng 下单平台 · 环境变量示例
# 复制为 .env 后按需修改：cp .env.example .env
# ============================================================

# ---------- 服务 ----------
NODE_ENV=development
PORT=4500
# 本机调试用 127.0.0.1；部署到服务器改成 0.0.0.0
HOST=127.0.0.1

# ---------- 数据库 ----------
# mysql = 使用 MySQL（生产）；memory = 内存驱动（无需数据库，重启不丢单）
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=xicheng_ordering
DB_POOL=10
# 启动时自动建表（首次部署很方便，生产可设为 false 后手动执行 sql/schema.sql）
DB_AUTO_MIGRATE=true
# 内存驱动下是否把数据落盘到 server/data/memory-db.json
MEMORY_PERSIST=true

# ---------- 管理后台 ----------
# 首次启动会用这组账号创建管理员（之后改这里不会覆盖已有密码）
ADMIN_USER=admin
ADMIN_PASSWORD=xicheng@2026
# 登录会话有效期（小时）
SESSION_HOURS=12
# 是否允许后台删除订单
ALLOW_DELETE_ORDER=true

# ---------- 下单频率限制 ----------
RL_ORDER_WINDOW_MS=60000
RL_ORDER_MAX=5
RL_LOGIN_WINDOW_MS=300000
RL_LOGIN_MAX=10

# ---------- 联系方式（会通过接口下发给前台展示） ----------
CONTACT_QQ=3493548230
CONTACT_WECHAT=xcq7689OnO

# ---------- 付款截图自动核验 ----------
# auto = OCR 自动核对（默认）：客户填转账单号 + 上传付款截图，单号/金额一致直接生成订单
# off  = 跳过 OCR，全部转人工核对（仅供测试/调试，生产请保持 auto）
OCR_MODE=auto
# 单张付款截图大小上限（字节），默认 5MB
# UPLOAD_MAX_BYTES=5242880

# ---------- 站点地址 ----------
PUBLIC_BASE_URL=
